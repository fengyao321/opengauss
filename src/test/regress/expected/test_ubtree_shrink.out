CREATE TABLE test_ubt_part (
    id int,
    status varchar(20),
    info text
) WITH (storage_type=ustore);
CREATE TABLE
CREATE INDEX idx_ubt_part_active ON test_ubt_part USING ubtree (id) WHERE status = 'active';
